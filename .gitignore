__pycache__/
*.pyc
*.egg-info/
.eggs/
build/
dist/
.venv/
.idea/
.vscode/

# generated outputs / data
output/
output_old/
results/
*.hdf5
*.gif
*.mp4
*.bin
*.mat
# keep small M-line records in version control if you want; ignored by default
mlines/

# study/ - the investigation record. Scripts, docs, logs and figures are tracked;
# the regenerable caches are not (they run to ~1 GB).
study/analysis/*.npy
study/analysis/tilecache/
study/montages/*.gif
!study/montages/*.png

# The study logs are the provenance for every number in docs/ - keep them tracked.
# A global gitignore (core.excludesFile) excludes *.log; a repo rule overrides it.
!study/logs/*.log

# regenerable caches written on 2026-09-24 (review follow-up)
study/analysis/atlas_cache/
study/analysis/panel_cache/*_cfwi.npz
study/analysis/atlas_cache_*/
study/analysis/atlas15_cache/

# buffer-3 head estimator exploration cache (2026-09-28)
study/analysis/unwrap_cache/

# general-line screen cache of the manual passive study (2026-09-29; regenerable, ~2 MB/folder)
study/analysis/general_screen_cache/
study/analysis/roi_auto_cache/
study/montages/passive_general/all_folders.pdf

# 2D wave maps: videos / GIFs / stills stay local (~12 MB per event); the demo event is committed
study/montages/passive_wave_map/*.mp4
study/montages/passive_wave_map/*.gif
study/montages/passive_wave_map/*_still.png
!study/montages/passive_wave_map/C000000027_MVC_w2.mp4
!study/montages/passive_wave_map/C000000027_MVC_w2_still.png

# evaluation of the manual passive reading (2026-10-05): results are the record (figures, summaries,
# tables); the frozen snapshots of Z: (~0.4 GB each) and the heavy caches are regenerable
!study/analysis/passive_manual_eval/results/
study/analysis/passive_manual_eval/snapshots/
study/analysis/passive_manual_eval/scratch/
study/analysis/passive_manual_eval/results/*/03_mline/raw*.json
study/analysis/passive_manual_eval/results/*/04_septum/measurements*.csv
study/analysis/passive_manual_eval/results/*/06_slopes/estimates.csv
study/analysis/passive_manual_eval/results/*.txt
